{
  "name": "neo-to-ynab",
  "version": "1.0.0",
  "description": "Convert a Neo Financial CSV export into a YNAB-ready import file.",
  "license": "MIT",
  "bin": {
    "neo-to-ynab": "convert.js"
  },
